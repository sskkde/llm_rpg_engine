# =============================================================================
# LLM RPG Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string (production/development)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_rpg

# For testing (SQLite in-memory)
# Tests automatically use this regardless of DATABASE_URL
TEST_DATABASE_URL=sqlite:///./test.db

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis connection string (optional, for caching)
# Set to empty or remove if not using Redis
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenAI API Key (required for production LLM calls)
# If not set, system falls back to MockLLMProvider
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Model selection (optional, defaults to gpt-4)
# OPENAI_MODEL=gpt-4

# =============================================================================
# Asset Provider Configuration (P10-A)
# =============================================================================

# Default asset provider (fallback if per-type vars are not set)
ASSET_PROVIDER_DEFAULT=mock

# Per-type provider overrides (fallback chain: per-type → category → DEFAULT → mock)
# Image providers (PORTRAIT, SCENE fall back to IMAGE if not set)
ASSET_PROVIDER_IMAGE=mock
ASSET_PROVIDER_PORTRAIT=mock
ASSET_PROVIDER_SCENE=mock

# Audio providers (BGM, SFX fall back to AUDIO if not set)
ASSET_PROVIDER_AUDIO=audio_placeholder
ASSET_PROVIDER_BGM=audio_placeholder
ASSET_PROVIDER_SFX=audio_placeholder

# =============================================================================
# Time Advance Configuration (P10-A)
# =============================================================================

# Time advance LLM mode: "reuse" (extract from world stage output, P10-A default)
# "explicit" (separate LLM call) is NOT yet implemented — deferred to P10-B
TIME_ADVANCE_LLM_MODE=reuse

# =============================================================================
# P10-B: Stage-Level LLM Routing
# =============================================================================

# Override LLM provider/model/params per stage. If not set, falls back to
# global LLM_* vars, then to per-stage hardcoded defaults.

# LLM_INPUT_INTENT_PROVIDER_MODE=auto
# LLM_INPUT_INTENT_DEFAULT_MODEL=gpt-4o-mini
# LLM_INPUT_INTENT_TEMPERATURE=0.3
# LLM_INPUT_INTENT_MAX_TOKENS=200
# LLM_INPUT_INTENT_TIMEOUT=15

# LLM_WORLD_PROVIDER_MODE=auto
# LLM_WORLD_DEFAULT_MODEL=gpt-4
# LLM_WORLD_TEMPERATURE=0.8
# LLM_WORLD_MAX_TOKENS=500
# LLM_WORLD_TIMEOUT=30

# LLM_SCENE_PROVIDER_MODE=auto
# LLM_SCENE_DEFAULT_MODEL=gpt-4
# LLM_SCENE_TEMPERATURE=0.8
# LLM_SCENE_MAX_TOKENS=500
# LLM_SCENE_TIMEOUT=30

# LLM_NPC_PROVIDER_MODE=auto
# LLM_NPC_DEFAULT_MODEL=gpt-4
# LLM_NPC_TEMPERATURE=0.8
# LLM_NPC_MAX_TOKENS=500
# LLM_NPC_TIMEOUT=30

# LLM_NARRATION_PROVIDER_MODE=auto
# LLM_NARRATION_DEFAULT_MODEL=gpt-4
# LLM_NARRATION_TEMPERATURE=0.8
# LLM_NARRATION_MAX_TOKENS=500
# LLM_NARRATION_TIMEOUT=30

# ── Global LLM overrides (fallback for all stages) ──────────────

# LLM_PROVIDER_MODE=auto
# LLM_DEFAULT_MODEL=gpt-4
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=500
# LLM_TIMEOUT=30

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key (generate a secure random string for production)
# Minimum 32 characters recommended
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars

# JWT Token expiration in minutes (default: 1440 = 24 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Application Settings
# =============================================================================

# Environment: development, testing, production
# - development: Debug mode enabled, legacy dev endpoints available
# - testing: SQLite database, mock LLM provider
# - production: PostgreSQL required, OpenAI provider
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed CORS origins (comma-separated)
# For development, include frontend and backend URLs
CORS_ORIGINS=http://localhost:3005,http://localhost:3000,http://localhost:8000,http://127.0.0.1:3005,http://127.0.0.1:3000,http://127.0.0.1:8000

# In production, set to your domain:
# CORS_ORIGINS=https://yourdomain.com

# =============================================================================
# Frontend Configuration (for Next.js)
# =============================================================================

# Backend API URL (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# These are used by docker-compose.yml
# Change these for production deployments

# PostgreSQL settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_rpg

# =============================================================================
# Optional: Feature Flags
# =============================================================================

# Enable/disable SSE streaming (default: true)
# ENABLE_STREAMING=true

# Enable/disable combat system (default: true)
# ENABLE_COMBAT=true

# Enable/disable admin endpoints (default: true)
# ENABLE_ADMIN=true

# Enable/disable debug endpoints (default: true in dev/test)
# ENABLE_DEBUG=true
