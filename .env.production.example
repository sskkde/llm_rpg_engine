# =============================================================================
# LLM RPG Engine - Production Environment Configuration
# =============================================================================
# Copy this file to .env and update values for production deployment
# IMPORTANT: Never commit real secrets or API keys to version control
# =============================================================================

# =============================================================================
# Application Environment
# =============================================================================

# Application environment mode
# - production: PostgreSQL required, OpenAI provider enabled, debug endpoints disabled
APP_ENV=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production recommends INFO or WARNING
LOG_LEVEL=INFO

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string for production
# Format: postgresql://user:password@host:port/database
# For docker-compose deployment, use 'postgres' as the hostname
DATABASE_URL=postgresql://postgres:your-secure-password@postgres:5432/llm_rpg

# Redis connection string (optional, for caching and rate limiting)
# Set to empty or remove if not using Redis
# For docker-compose deployment, use 'redis' as the hostname
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret Key for authentication token signing
# Generate a secure random string: openssl rand -hex 32
# Minimum 32 characters required, 64 characters recommended for production
SECRET_KEY=generate-with-openssl-rand-hex-32-minimum-32-characters

# Admin API access token (optional)
# Used for admin endpoints authentication
# Generate with: openssl rand -hex 16
ADMIN_TOKEN=your-admin-token-change-in-production

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# OpenAI API Key (required for production LLM calls)
# If not set, system will fall back to MockLLMProvider (not recommended for production)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API base URL (optional)
# Use this for custom OpenAI-compatible endpoints or proxies
# Leave empty or remove for default OpenAI API
OPENAI_BASE_URL=

# =============================================================================
# Asset Provider Configuration (P10-A)
# =============================================================================

# Default asset provider (fallback if per-type vars are not set)
# Production: Set to 'openai' for real generation, 'mock' for placeholders
ASSET_PROVIDER_DEFAULT=openai

# Per-type provider overrides (fallback chain: per-type → category → DEFAULT → mock)
# Image providers (PORTRAIT, SCENE fall back to IMAGE if not set)
# Configure real providers (openai, stability-ai, etc.) for production
ASSET_PROVIDER_IMAGE=openai
ASSET_PROVIDER_PORTRAIT=openai
ASSET_PROVIDER_SCENE=openai

# Audio providers (BGM, SFX fall back to AUDIO if not set)
# Configure real providers (elevenlabs, etc.) for production
# 'audio_placeholder' returns silent placeholder URLs
ASSET_PROVIDER_AUDIO=audio_placeholder
ASSET_PROVIDER_BGM=audio_placeholder
ASSET_PROVIDER_SFX=audio_placeholder

# =============================================================================
# Time Advance Configuration (P10-A)
# =============================================================================

# Time advance LLM mode: "reuse" (extract from world stage output, P10-A default)
# "explicit" (separate LLM call) is NOT yet implemented — deferred to P10-B
# - "reuse": Faster, reuses world stage LLM output (recommended for production)
# - "explicit": Slower, makes separate LLM call for time extraction (more accurate, P10-B scope)
TIME_ADVANCE_LLM_MODE=reuse

# =============================================================================
# P10-B: Stage-Level LLM Routing
# =============================================================================

# Override LLM provider/model/params per stage. If not set, falls back to
# global LLM_* vars, then to per-stage hardcoded defaults.

# LLM_INPUT_INTENT_PROVIDER_MODE=auto
# LLM_INPUT_INTENT_DEFAULT_MODEL=gpt-4o-mini
# LLM_INPUT_INTENT_TEMPERATURE=0.3
# LLM_INPUT_INTENT_MAX_TOKENS=200
# LLM_INPUT_INTENT_TIMEOUT=15

# LLM_WORLD_PROVIDER_MODE=auto
# LLM_WORLD_DEFAULT_MODEL=gpt-4
# LLM_WORLD_TEMPERATURE=0.8
# LLM_WORLD_MAX_TOKENS=500
# LLM_WORLD_TIMEOUT=30

# LLM_SCENE_PROVIDER_MODE=auto
# LLM_SCENE_DEFAULT_MODEL=gpt-4
# LLM_SCENE_TEMPERATURE=0.8
# LLM_SCENE_MAX_TOKENS=500
# LLM_SCENE_TIMEOUT=30

# LLM_NPC_PROVIDER_MODE=auto
# LLM_NPC_DEFAULT_MODEL=gpt-4
# LLM_NPC_TEMPERATURE=0.8
# LLM_NPC_MAX_TOKENS=500
# LLM_NPC_TIMEOUT=30

# LLM_NARRATION_PROVIDER_MODE=auto
# LLM_NARRATION_DEFAULT_MODEL=gpt-4
# LLM_NARRATION_TEMPERATURE=0.8
# LLM_NARRATION_MAX_TOKENS=500
# LLM_NARRATION_TIMEOUT=30

# ── Global LLM overrides (fallback for all stages) ──────────────

# LLM_PROVIDER_MODE=auto
# LLM_DEFAULT_MODEL=gpt-4
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=500
# LLM_TIMEOUT=30

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed CORS origins (comma-separated)
# Production: Set to your production domain(s)
# Example: https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# =============================================================================
# Frontend Configuration (for Next.js)
# =============================================================================

# Backend API URL for frontend server-side rewrites
# Used by Next.js server to forward API requests to backend
# For same-host deployment: http://127.0.0.1:8000
# For docker network: http://backend:8000 (if using service name)
BACKEND_API_URL=http://127.0.0.1:8000

# Frontend API URL for browser calls (same-origin)
# Browser API calls should stay same-origin, leave empty for production
# The frontend uses rewrites to forward API requests
NEXT_PUBLIC_API_URL=

# =============================================================================
# Media / Asset Configuration
# =============================================================================

# Asset provider for media generation
# - openai: Use OpenAI DALL-E for image generation (requires OPENAI_API_KEY)
# - mock: Use mock provider with placeholder URLs (development/testing only)
ASSET_PROVIDER=openai

# Whether to use fake fallback when asset generation fails
# - true: Fall back to placeholder URLs on failure
# - false: Return error on generation failure
ASSET_OPENAI_FAKE_FALLBACK=false

# Rate limit for asset generation per user per day
# Number of generations allowed per user within 24 hours
ASSET_RATE_LIMIT_USER_PER_DAY=50

# =============================================================================
# Docker Compose Configuration
# =============================================================================

# PostgreSQL credentials for docker-compose
# Change these for production deployments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=llm_rpg

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable SSE streaming for real-time narration (default: true)
# SSE streaming provides progressive narration output
ENABLE_STREAMING=true

# Enable/disable combat system (default: true)
# Combat allows turn-based battles with NPCs
ENABLE_COMBAT=true

# =============================================================================
# Additional Production Notes
# =============================================================================
# 
# 1. Generate SECRET_KEY: openssl rand -hex 32
# 2. Generate ADMIN_TOKEN: openssl rand -hex 16
# 3. Change POSTGRES_PASSWORD to a strong random password
# 4. Set CORS_ORIGINS to your actual production domain(s)
# 5. Keep NEXT_PUBLIC_API_URL empty for same-origin production deployment
# 6. Use HTTPS in production for all URLs
# 7. Ensure OPENAI_API_KEY is valid and has sufficient quota
# 
# =============================================================================
